{
  "info": {
    "name": "AI CV Analyzer - Starter API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "cvServiceUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "cvId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Gateway health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "CV Service health",
      "request": {
        "method": "GET",
        "url": "{{cvServiceUrl}}/health"
      }
    },
    {
      "name": "Create CV - success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Nguyen Van A\", \"email\": \"a@example.com\", \"content\": \"Backend developer with Node.js PostgreSQL REST API and Git project experience.\"}"
        },
        "url": "{{baseUrl}}/api/cvs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CV is created', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('cvId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Upload CV - PDF or DOCX",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "name",
              "value": "Nguyen Van A",
              "type": "text"
            },
            {
              "key": "email",
              "value": "a@example.com",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/api/cvs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CV file is uploaded', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('cvId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List CVs",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cvs"
      }
    },
    {
      "name": "Get CV by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cvs/{{cvId}}"
      }
    },
    {
      "name": "Delete CV by ID",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/cvs/{{cvId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CV is deleted', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create CV - business error",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"A\", \"content\": \"too short\"}"
        },
        "url": "{{baseUrl}}/api/cvs"
      }
    },
    {
      "name": "Create JD - success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Backend Intern\", \"company\": \"Example Co\", \"content\": \"Requirements: Node.js PostgreSQL Docker REST API Git communication\"}"
        },
        "url": "{{baseUrl}}/api/jds"
      }
    },
    {
      "name": "List JDs",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/jds"
      }
    },
    {
      "name": "Get JD by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/jds/1"
      }
    },
    {
      "name": "Create analysis",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"cvId\": 1, \"jdId\": 1}"
        },
        "url": "{{baseUrl}}/api/analyses"
      }
    },
    {
      "name": "Get analysis",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/analyses/1"
      }
    },
    {
      "name": "Get skill gaps",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/analyses/1/skill-gaps"
      }
    },
    {
      "name": "Get recommendations",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/analyses/1/recommendations"
      }
    },
    {
      "name": "Analysis invalid input",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"cvId\": -1, \"jdId\": \"abc\"}"
        },
        "url": "{{baseUrl}}/api/analyses"
      }
    }
  ]
}