# Local development configuration. Keep .env private and do not commit it.
GATEWAY_PORT=8080
CV_SERVICE_PORT=3001
JD_SERVICE_PORT=3002
ANALYSIS_SERVICE_PORT=3003

# Internal service calls retry transient network failures and time out in milliseconds.
HTTP_TIMEOUT_MS=2500
HTTP_RETRIES=1

# These credentials match the PostgreSQL volumes already created for this project.
CV_DB_NAME=cv_db
CV_DB_USER=cv_user
CV_DB_PASSWORD=cv_pass

JD_DB_NAME=jd_db
JD_DB_USER=jd_user
JD_DB_PASSWORD=jd_pass

ANALYSIS_DB_NAME=analysis_db
ANALYSIS_DB_USER=analysis_user
ANALYSIS_DB_PASSWORD=analysis_pass

# Optional. Leave blank to use heuristic CV extraction.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
